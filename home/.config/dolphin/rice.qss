/* Typography matches the quickshell bar. */
* {
    font-family: "Aptos Narrow";
    font-size: 13px;
}

/* Dolphin's window chrome. The icon grid uses the Qt palette and MacTahoe. */
QToolBar#mainToolBar {
    background: #101010;
    border: 0;
    border-bottom: 1px solid #262626;
    padding: 7px 11px;
    spacing: 5px;
}

QToolBar#mainToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 9px;
    padding: 4px;
    min-width: 21px;
    min-height: 21px;
}

QToolBar#mainToolBar QToolButton:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(255,255,255,0.05);
}

QToolBar#mainToolBar QToolButton:pressed,
QToolBar#mainToolBar QToolButton:checked {
    background: #2a2a2a;
}

QToolBar#mainToolBar QToolButton:disabled {
    background: transparent;
}

QToolBar#mainToolBar::separator {
    width: 8px;
    background: transparent;
}

KUrlNavigator {
    background: #0a0a0a;
    border: 1px solid #262626;
    border-radius: 10px;
    padding: 1px 5px;
}

KUrlNavigator QToolButton {
    border: 0;
    padding: 3px;
}

QDockWidget#placesDock {
    background: #101010;
    color: #8a8a8a;
    font-size: 12px;
}

QDockWidget#placesDock::title {
    background: #101010;
    padding: 8px 11px 4px;
}

KFilePlacesView {
    background: #101010;
    color: #d4d4d4;
    border: 0;
    padding: 3px 6px;
    outline: 0;
}

KFilePlacesView::item {
    min-height: 26px;
    padding-left: 4px;
    border-radius: 8px;
}

KFilePlacesView::item:hover {
    background: rgba(255,255,255,0.07);
}

KFilePlacesView::item:selected {
    background: #2a2a2a;
    color: #f5f7fa;
}

QMainWindow::separator {
    background: #262626;
    width: 1px;
    height: 1px;
}

QScrollBar:vertical {
    background: transparent;
    width: 9px;
    margin: 2px 1px;
}

QScrollBar::handle:vertical {
    background: #3a3a3a;
    min-height: 28px;
    border-radius: 3px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}
