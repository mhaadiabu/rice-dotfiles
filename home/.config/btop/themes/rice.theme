# btop rice theme
# Matches niri rice palette: Aptos Narrow, dark #101418 background, #a9c9eb accent

# Main background, empty for terminal default transparency
theme[main_bg]=""

# Main text color
theme[main_fg]="#e0e2e8"

# Title color for boxes
theme[title]="#e0e2e8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#a9c9eb"

# Background color of selected item in processes box
theme[selected_bg]="#1e3a5f"

# Foreground color of selected item in processes box
theme[selected_fg]="#ffffff"

# Color of inactive/disabled text
theme[inactive_fg]="#52525b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#7c9ec5"

# Cpu box outline color
theme[cpu_box]="#262d38"

# Memory/disks box outline color
theme[mem_box]="#262d38"

# Net up/down box outline color
theme[net_box]="#262d38"

# Processes box outline color
theme[proc_box]="#262d38"

# Box divider line and small boxes line color
theme[div_line]="#1f242b"

# Temperature graph colors
theme[temp_start]="#60b8ff"
theme[temp_mid]="#fff77c"
theme[temp_end]="#ff3270"

# CPU graph colors
theme[cpu_start]="#60b8ff"
theme[cpu_mid]="#7c9ec5"
theme[cpu_end]="#ff739e"

# Mem/Disk free meter
theme[free_start]="#42f558"
theme[free_mid]="#7cff8d"
theme[free_end]="#60b8ff"

# Mem/Disk cached meter
theme[cached_start]="#7c9ec5"
theme[cached_mid]="#a9c9eb"
theme[cached_end]="#8b7cb5"

# Mem/Disk available meter
theme[available_start]="#60b8ff"
theme[available_mid]="#7c9ec5"
theme[available_end]="#a9c9eb"

# Mem/Disk used meter
theme[used_start]="#60b8ff"
theme[used_mid]="#7c9ec5"
theme[used_end]="#ff739e"

# Download graph colors
theme[download_start]="#42f558"
theme[download_mid]="#7cff8d"
theme[download_end]="#60b8ff"

# Upload graph colors
theme[upload_start]="#ff739e"
theme[upload_mid]="#ff3270"
theme[upload_end]="#fff332"
